# Variáveis de desenvolvimento. Nunca coloque segredos reais no repositório.
# Gere um valor aleatório com pelo menos 32 caracteres para CSRF_SECRET.
CSRF_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Código aleatório usado somente para criar o primeiro administrador.
ADMIN_SETUP_SECRET=replace-with-another-long-random-secret

# Origem pública exata, sem barra final. Em desenvolvimento, use localhost.
APP_ORIGIN=http://localhost:5173

# Recuperação de senha por e-mail (Resend). Deixe vazio até configurar o domínio remetente.
RESEND_API_KEY=
MAIL_FROM=Nobre Barber Club <conta@seudominio.com.br>
